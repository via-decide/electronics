  "evidence_claims": {
    "FACT": "The cited RP2350 and W25Q256JV sources define SPI0 pin functions, SPI controller behavior, flash identity, geometry, opcodes, power-up delays, status semantics and maximum program/erase times used by this contract.",
    "DECISION": "Proto-0 assigns SPI0 and manual payload chip-select exclusively to one serialized payload-storage service using standard SPI and dedicated four-byte opcodes.",
    "EXPECTED": "A single blocking owner with bounded operations and no automatic mutation retry is expected to make command framing and unknown reset outcomes deterministic enough for later transaction recovery.",
    "MEASURED": "NONE",
    "UNKNOWN": "Actual clock, signal integrity, transfer latency, queue behavior, timeout distributions, RUN-to-bus-quiescent timing, flash behavior during power cuts and all physical recovery results."
  },
  "blocking_validation": [
    "implement the typed owner service and prohibit direct SPI0 access at link and review boundaries",
    "add host tests for bounds alignment page crossing opcode allowlists state transitions and timeout paths",
    "capture logic-analyzer traces for every allowed command and prohibited command attempt",
    "measure the actual SPI clock and verify mode zero timing at TP11 through TP14",
    "prove chip select remains high during reset boot and power-fault entry",
    "prove the 25 us maximum RUN-to-bus-quiescent allocation or revise Task 3 hold-up",
    "inject reset during read program and erase and record unknown-outcome recovery",
    "prove no mutation is automatically retried after timeout or reset",
    "complete higher-level transaction and commit semantics before exposing payload data as committed",
    "complete Task 5 USB power qualification before permitting payload mutation",
    "complete Task 6 sourcing and signal-integrity review"
  ],
