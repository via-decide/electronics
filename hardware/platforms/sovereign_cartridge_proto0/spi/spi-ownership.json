  "state_machine": [
    {
      "state": "UNINITIALIZED",
      "entry": "reset generation changed or power became valid",
      "action": "leave CS high, wait power-up delays and reject payload requests"
    },
    {
      "state": "PROBING",
      "entry": "power-safe delay elapsed",
      "action": "read JEDEC ID and status registers through the exclusive owner"
    },
    {
      "state": "IDLE",
      "entry": "EF4019 identity confirmed, BUSY=0 and no request is active",
      "action": "CS remains high and one typed request may be dequeued"
    },
    {
      "state": "ACQUIRED",
      "entry": "owner accepted one validated request",
      "action": "assert CS only for one command frame and prevent cancellation"
    },
    {
      "state": "WAIT_BUSY",
      "entry": "a program or erase command was accepted",
      "action": "poll status within the operation-specific bounded timeout"
    },
    {
      "state": "VERIFY",
      "entry": "BUSY cleared after a mutation",
      "action": "confirm WEL=0 and read back the full target range"
    },
    {
      "state": "RECOVER",
      "entry": "reset, timeout, protocol error, identity loss or unknown operation outcome",
      "action": "reject new mutations, leave CS high, probe status and never replay a mutation automatically"
    },
    {
      "state": "FAULT_LOCKED",
      "entry": "identity mismatch, BUSY timeout, unsafe reset precondition or verification failure",
      "action": "permit diagnostics only until explicit service recovery or power cycle"
    }
  ],
