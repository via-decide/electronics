{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/via-decide/electronics/schemas/sovereign-cartridge-proto0-topology.schema.json",
  "title": "Sovereign Cartridge Proto-0 topology",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topology_id",
    "product",
    "revision",
    "status",
    "evidence_status",
    "invariant",
    "blocks",
    "connections",
    "power_domains",
    "interfaces",
    "required_test_nets",
    "physical_boundaries",
    "authorization",
    "phase_gates",
    "deferred_decisions",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "topology_id": {
      "const": "sovereign-cartridge-proto0"
    },
    "product": {
      "const": "Sovereign Cartridge"
    },
    "revision": {
      "const": "PROTO-0"
    },
    "status": {
      "const": "TOPOLOGY_FROZEN"
    },
    "evidence_status": {
      "const": "DESIGN_ONLY"
    },
    "invariant": {
      "type": "string",
      "minLength": 20
    },
    "blocks": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "connections": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "power_domains": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nominal_voltage_v",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "nominal_voltage_v": {
            "type": "number"
          },
          "source": {
            "type": "string"
          },
          "current_budget": {
            "type": "string"
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "interfaces": {
      "type": "object",
      "required": [
        "usb_service",
        "payload_spi",
        "debug"
      ]
    },
    "required_test_nets": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 14,
      "items": {
        "type": "string"
      }
    },
    "physical_boundaries": {
      "type": "object"
    },
    "authorization": {
      "type": "object",
      "required": [
        "real_hardware_enabled",
        "destructive_storage_writes_enabled",
        "manufacturing_release_enabled",
        "required_before_hardware"
      ]
    },
    "phase_gates": {
      "type": "object"
    },
    "deferred_decisions": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "task",
          "owner",
          "items"
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "title",
          "url",
          "supports",
          "retrieved_at"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "retrieved_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": [
        "id",
        "type",
        "part",
        "power_domain",
        "responsibility"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "part": {
          "type": "string"
        },
        "silicon_stepping": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "capacity_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "power_domain": {
          "type": "string"
        },
        "responsibility": {
          "type": "string"
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      }
    }
  }
}
